<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.outthislife.azerothsurvivors.progression"
    android:versionCode="4" android:versionName="0.2.0-android.4">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="4198400" android:required="true" />
    <application android:label="Azeroth Survivors Progression"
        android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false"
        android:extractNativeLibs="true" android:icon="@drawable/launcher_icon">
        <activity android:name=".SetupActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameActivity" android:process=":game" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|density|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="azeroth_android" />
        </activity>
    </application>
</manifest>
